  "name": "Razer Naga Left-Handed Edition 2020",
  "vid": "0x1532",
  "pid": "0x008d",
  "interface": 0,
  "transaction_id": "0x1f",
  "profiles": [0, 1, 2, 3, 4, 5],
  "layers": ["normal", "hypershift"],
  "dpi_max": 20000,
  "buttons": [
    { "id": "0x01", "name": "left", "at": [40, 28] },
    { "id": "0x02", "name": "right", "at": [60, 28] },
    { "id": "0x09", "name": "wheel-up", "at": [50, 10] },
    { "id": "0x03", "name": "middle", "at": [50, 18] },
    { "id": "0x0a", "name": "wheel-down", "at": [50, 26] },
    { "id": "0x34", "name": "tilt-left", "at": [42, 16] },
    { "id": "0x35", "name": "tilt-right", "at": [58, 16] },
    { "id": "0x0b", "name": "dpi-up", "at": [50, 34] },
    { "id": "0x0c", "name": "dpi-down", "at": [50, 40] },
    { "id": "0x0e", "name": "profile", "at": [50, 62] },
    { "id": "0x40", "name": "thumb1", "at": [78, 30] },
    { "id": "0x41", "name": "thumb2", "at": [86, 30] },
    { "id": "0x42", "name": "thumb3", "at": [94, 30] },
